rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ═══════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════
    //  USERS
    // ═══════════════════════════════════════════════

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════
    //  SELECTED INTERESTS
    // ═══════════════════════════════════════════════

    match /selected_interests/{interest} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  DAILY WORDS
    // ═══════════════════════════════════════════════

    match /daily_words/{document} {
      // Public read so daily word loads before auth completes
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  GAME DATA  (Public read — question bank)
    // ═══════════════════════════════════════════════

    match /game_questions/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /game_achievements/{document} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                     && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                     && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  LEADERBOARD  (Public read)
    // ═══════════════════════════════════════════════

    match /leaderboard/{document} {
      allow read: if isAuthenticated();
      // Users can write their own leaderboard entry (document ID = userId).
      // This lets every player's score/XP appear on the global leaderboard.
      allow create: if isAuthenticated()
                     && request.resource.data.userId == request.auth.uid
                     && document == request.auth.uid;
      allow update: if isAuthenticated()
                     && resource.data.userId == request.auth.uid
                     && document == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  ADMIN NOTIFICATIONS
    // ═══════════════════════════════════════════════

    match /admin_notifications/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  FEEDBACK
    // ═══════════════════════════════════════════════

    match /feedback/{document} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  USER-OWNED PROGRESS COLLECTIONS
    //  Document ID = userId
    // ═══════════════════════════════════════════════

    match /progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /game_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /game_levels/{document} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /game_statistics/{document} {
      allow read, write: if isAuthenticated();
    }

    match /game_statistics_meta/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /study_plan/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /mock_test_progress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════
    //  ADMIN-ONLY CONTENT COLLECTIONS
    //  Managed through the admin panel
    // ═══════════════════════════════════════════════

    match /content_vocabulary_chapters/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /content_vocabulary_words/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /content_grammar_chapters/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  VOCABULARY  — app query
    // ═══════════════════════════════════════════════

    match /vocabulary/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  CONFIG / APP SETTINGS  — app reads on startup
    // ═══════════════════════════════════════════════

    match /Config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  HOMEWORK  (Admin only)
    // ═══════════════════════════════════════════════

    match /homework/{homeworkId} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  ★ NEW: ADMIN API KEYS
    //  Structure: admin_api_keys/{keyId}
    //  All users read, only admin write.
    //  Hardened: addedBy must match the creator's auth uid, stat counters
    //  must start at 0, and updates are split into config-only vs stat-only
    //  so addedBy/createdAt are immutable and counters can't be tampered
    //  (manager uses FieldValue.increment on stat fields only).
    // ═══════════════════════════════════════════════

    function onlyKeysAffected(set) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(set);
    }

    match /admin_api_keys/{keyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.usageCount == 0
        && request.resource.data.errorCount == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.key is string
        && request.resource.data.key.size() > 0;
      allow update: if isAdmin() && (
        onlyKeysAffected(['name','key','baseUrl','model','provider','priority','isActive','updatedAt'])
        || onlyKeysAffected(['usageCount','errorCount','lastUsedAt','lastErrorAt'])
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  ★ NEW: ADMIN KEY GROUPS (provider → group config)
    //  Structure: admin_key_groups/{provider}
    //  All users read (defaults for key pool), only admin write.
    //  Hardened: doc id must be a known provider, fields type-checked,
    //  and updates limited to config fields (incl. cooldown overrides).
    // ═══════════════════════════════════════════════

    match /admin_key_groups/{provider} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
        && provider in ['google','openrouter','custom']
        && request.resource.data.name is string
        && request.resource.data.enabled is bool
        && request.resource.data.priority is int;
      allow update: if isAdmin()
        && provider in ['google','openrouter','custom']
        && onlyKeysAffected(['name','enabled','priority','rateLimitCooldownSeconds','serverErrorCooldownSeconds','defaultCooldownSeconds']);
      allow delete: if isAdmin()
        && provider in ['google','openrouter','custom'];
    }

    // ═══════════════════════════════════════════════
    //  ★ NEW: API ERROR LOGS
    //  Structure: api_error_logs/{logId}
    //  Authenticated users can write (report errors)
    //  Admin can read
    // ═══════════════════════════════════════════════

    match /api_error_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  ★ NEW: ADMIN NOTIFICATION TARGETS
    //  Structure: admin_notification_targets/{targetId}
    // ═══════════════════════════════════════════════

    match /admin_notification_targets/{targetId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  ★ NEW: ADMIN ALERTS (in-app outage banner)
    //  Structure: admin_alerts/{alertId}
    //  Written by ApiKeyManager when all keys fail; dismissed by admin UI.
    // ═══════════════════════════════════════════════

    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  DAILY QUIZ LEADERBOARD
    //  Structure: daily_quiz_leaderboard/{date}/entries/{userId}
    // ═══════════════════════════════════════════════

    match /daily_quiz_leaderboard/{date}/entries/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  BATTLE ARENA — PRESENCE
    //  Structure: battle_presence/{userId}
    //  Each user writes only their own presence doc (heartbeat every 45s).
    // ═══════════════════════════════════════════════

    match /battle_presence/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.id == request.auth.uid
        && request.resource.data.isOnline is bool
        && request.resource.data.trophies is int;
      allow update: if isOwner(userId)
        && request.resource.data.id == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  BATTLE ARENA — CHALLENGES (1v1 Direct)
    //  Structure: battle_challenges/{challengeId}
    //  Fields: fromUserId, toUserId, status(pending/accepted/rejected), roomId
    // ═══════════════════════════════════════════════

    match /battle_challenges/{challengeId} {
      allow read: if isAuthenticated()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromUserId is string
        && request.resource.data.toUserId is string;
      // Only the receiver can accept/reject (status + optional roomId)
      allow update: if isAuthenticated()
        && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && onlyKeysAffected(['status', 'roomId']);
      allow delete: if isAdmin()
        || (isAuthenticated() && (
             resource.data.fromUserId == request.auth.uid
             || resource.data.toUserId == request.auth.uid));
    }

    // ═══════════════════════════════════════════════
    //  BATTLE ARENA — MATCHMAKING QUEUE
    //  Structure: battle_queue/{queueId}
    //  Fields: userId, userName, trophies, status(waiting/matched), roomId, createdAt
    // ═══════════════════════════════════════════════

    match /battle_queue/{queueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.userId is string;
      // Owner can delete own entry (timeout); any authenticated user can mark 'matched' when pairing
      // For matched transition, only status + roomId may change
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid)
        || (resource.data.status == 'waiting'
            && request.resource.data.status == 'matched'
            && request.resource.data.roomId is string
            && onlyKeysAffected(['status', 'roomId']))
      );
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ═══════════════════════════════════════════════
    //  BATTLE ARENA — ROOMS
    //  Structure: battle_rooms/{roomId}
    //  Fields: player1{id,name,trophies,currentScore...}, player2{...},
    //          questions[], status(in_progress/completed), winnerId,
    //          activeEmote, emoteSenderId, currentRoundIndex
    // ═══════════════════════════════════════════════

    function isBattleParticipant() {
      return isAuthenticated()
        && (resource.data.player1.id == request.auth.uid
            || resource.data.player2.id == request.auth.uid);
    }

    function isBattleParticipantOnCreate() {
      return isAuthenticated()
        && (request.resource.data.player1.id == request.auth.uid
            || request.resource.data.player2.id == request.auth.uid);
    }

    // Player identity fields, when present in the update, must not change.
    // (Partial updates — e.g. just 'player1.roundAnswers.0' — don't carry an
    //  'id' key, so we must guard the access with 'in' to avoid a rule error.)
    function battlePlayersUnchanged() {
      return (!('player1' in request.resource.data)
              || !('id' in request.resource.data.player1)
              || request.resource.data.player1.id == resource.data.player1.id)
        && (!('player2' in request.resource.data)
              || !('id' in request.resource.data.player2)
              || request.resource.data.player2.id == resource.data.player2.id);
    }

    // Questions are immutable after creation (client can only patch state).
    function battleQuestionsUnchanged() {
      return !('questions' in request.resource.data)
        || request.resource.data.questions == resource.data.questions;
    }

    match /battle_rooms/{roomId} {
      allow read: if isBattleParticipant() || isAdmin();
      allow create: if isBattleParticipantOnCreate()
        && request.resource.data.status in ['in_progress', 'waiting']
        && request.resource.data.player1.id is string
        && request.resource.data.player2.id is string
        && request.resource.data.questions is list;
      // Participants can update scores/answers/emotes/rounds/forfeit/completion.
      // Questions & player identities are immutable after creation.
      allow update: if isBattleParticipant()
        && battlePlayersUnchanged()
        && battleQuestionsUnchanged();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    //  DENY ALL OTHER COLLECTIONS
    // ═══════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
